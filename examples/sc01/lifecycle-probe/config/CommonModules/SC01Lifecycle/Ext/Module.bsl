// Isolated laboratory instrumentation. Never load into a user's business configuration.

Процедура RunController(Каталог) Экспорт
    ПроверитьКаталог(Каталог);
    Эксперимент = Строка(Новый УникальныйИдентификатор());
    ОбщийКлюч = "SC01LIFECYCLE:" + Эксперимент;
    Пакет = Наблюдение("batch_started");
    Пакет.Вставить("batch_id", Эксперимент);
    Пакет.Вставить("shared_job_key", ОбщийКлюч);
    Пакет.Вставить("expected_cases_passed", Ложь);
    Пакет.Вставить("cases", Новый Массив);
    Пакет.Вставить("status", "running");
    ЗаписатьСнимок(ПутьСнимка(Каталог, "batch-" + Эксперимент + ".json"), Пакет);

    Первый = RunCase(Каталог, Эксперимент, ОбщийКлюч, 1, Ложь);
    Пакет.cases.Добавить(Первый);
    ЗаписатьСнимок(ПутьСнимка(Каталог, "batch-" + Эксперимент + ".json"), Пакет);
    // A key may be reused only after the first platform job is no longer active.
    Если Первый.status = "completed" Тогда
        Второй = RunCase(Каталог, Эксперимент, ОбщийКлюч, 2, Истина);
        Пакет.cases.Добавить(Второй);
        Если Второй.status = "failed" Тогда
            Пакет.Вставить("expected_cases_passed", Первый.job_uuid <> Второй.job_uuid
                И Первый.final_job_snapshot.job_key = ОбщийКлюч
                И Второй.final_job_snapshot.job_key = ОбщийКлюч);
        КонецЕсли;
        Пакет.Вставить("status", "finished");
    Иначе
        Пакет.Вставить("status", "first_case_did_not_complete");
    КонецЕсли;
    Пакет.Вставить("finished_observation", Наблюдение("batch_finished"));
    ЗаписатьСнимок(ПутьСнимка(Каталог, "batch-" + Эксперимент + ".json"), Пакет);
КонецПроцедуры

Функция RunCase(Каталог, Эксперимент, ОбщийКлюч, Порядок, ДолжнаБытьОшибка)
    Nonce = Строка(Новый УникальныйИдентификатор());
    Этапы = Новый Массив;
    Контроллер = Наблюдение("controller_created");
    Контроллер.Вставить("batch_id", Эксперимент);
    Контроллер.Вставить("job_ordinal", Порядок);
    Контроллер.Вставить("expected_failure", ДолжнаБытьОшибка);
    Контроллер.Вставить("requested_job_key", ОбщийКлюч);
    Контроллер.Вставить("nonce", Nonce);
    Контроллер.Вставить("connection_string", СтрокаСоединенияИнформационнойБазы());
    Контроллер.Вставить("initiator_session_id", НомерСеансаИнформационнойБазы());
    Контроллер.Вставить("stages", Этапы);
    Контроллер.Вставить("status", "submitting");
    Этапы.Добавить(Наблюдение("submit_requested"));
    ЗаписатьСнимок(ПутьСнимка(Каталог, "controller-" + Nonce + ".json"), Контроллер);

    Попытка
        Параметры = Новый Массив;
        Параметры.Добавить(Nonce);
        Параметры.Добавить(Каталог);
        Параметры.Добавить(ДолжнаБытьОшибка);
        Параметры.Добавить(Эксперимент);
        Параметры.Добавить(Порядок);
        Задание = ФоновыеЗадания.Выполнить("SC01Lifecycle.OrderLoad", Параметры, ОбщийКлюч,
            "SC01 isolated two-second background job");
        ИдентификаторЗадания = Задание.УникальныйИдентификатор;
        Контроллер.Вставить("job_uuid", Строка(ИдентификаторЗадания));
        Контроллер.Вставить("status", "submitted");
        Этапы.Добавить(Наблюдение("execute_returned"));
        ЗаписатьСнимок(ПутьСнимка(Каталог, "controller-" + Nonce + ".json"), Контроллер);

        // This is bounded observation, not an inferred queue timestamp.
        Задание = Задание.ОжидатьЗавершенияВыполнения(15);
        Задание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(ИдентификаторЗадания);
        Если Задание = Неопределено Тогда
            ВызватьИсключение "SC01: background job was not found after waiting";
        КонецЕсли;
        Итог = Наблюдение("platform_state_refreshed");
        Итог.Вставить("job_uuid", Строка(Задание.УникальныйИдентификатор));
        Итог.Вставить("job_state", Строка(Задание.Состояние));
        Итог.Вставить("job_state_code", КодСостоянияЗадания(Задание.Состояние));
        Итог.Вставить("completed", Задание.Состояние = СостояниеФоновогоЗадания.Завершено);
        Итог.Вставить("job_method", Задание.ИмяМетода);
        Итог.Вставить("job_key", Задание.Ключ);
        Итог.Вставить("job_begin_platform_date", XMLСтрока(Задание.Начало));
        Итог.Вставить("platform_date_precision", "seconds");
        Итог.Вставить("platform_date_timezone", "not_assumed; compare with independent UTC observations");
        Если Задание.Состояние <> СостояниеФоновогоЗадания.Активно Тогда
            Итог.Вставить("job_end_platform_date", XMLСтрока(Задание.Конец));
        КонецЕсли;
        Если Задание.ИнформацияОбОшибке <> Неопределено Тогда
            Итог.Вставить("error_description", Задание.ИнформацияОбОшибке.Описание);
        КонецЕсли;
        Контроллер.Вставить("final_job_snapshot", Итог);
        Контроллер.Вставить("status", Итог.job_state_code);
        Этапы.Добавить(Наблюдение("controller_finished"));
    Исключение
        Контроллер.Вставить("status", "error");
        Контроллер.Вставить("error", ОписаниеОшибки());
        Этапы.Добавить(Наблюдение("controller_error"));
    КонецПопытки;
    ЗаписатьСнимок(ПутьСнимка(Каталог, "controller-" + Nonce + ".json"), Контроллер);
    Возврат Контроллер;
КонецФункции

Процедура OrderLoad(Nonce, Каталог, ДолжнаБытьОшибка, Эксперимент, Порядок) Экспорт
    Сеанс = ПолучитьТекущийСеансИнформационнойБазы();
    Задание = Сеанс.ПолучитьФоновоеЗадание();
    Если Задание = Неопределено Тогда
        ВызватьИсключение "SC01: worker is not executing as a platform background job";
    КонецЕсли;
    UUIDЗадания = Строка(Задание.УникальныйИдентификатор);
    Вход = Наблюдение("body_enter");
    Вход.Вставить("batch_id", Эксперимент);
    Вход.Вставить("job_ordinal", Порядок);
    Вход.Вставить("expected_failure", ДолжнаБытьОшибка);
    Вход.Вставить("nonce", Nonce);
    Вход.Вставить("job_uuid", UUIDЗадания);
    Вход.Вставить("job_key", Задание.Ключ);
    Вход.Вставить("session_id", НомерСеансаИнформационнойБазы());
    Вход.Вставить("session_info_number", Сеанс.НомерСеанса);
    Вход.Вставить("connection_id", Сеанс.НомерСоединения);
    Вход.Вставить("connection_string", СтрокаСоединенияИнформационнойБазы());
    Вход.Вставить("job_begin_platform_date", XMLСтрока(Задание.Начало));
    Вход.Вставить("platform_date_precision", "seconds");
    Вход.Вставить("platform_date_timezone", "not_assumed; compare with independent UTC observations");
    Вход.Вставить("interpretation", "callback body entered; not a platform job-start event");
    ЗаписатьСнимок(ПутьСнимка(Каталог, "worker-enter-" + Nonce + ".json"), Вход);

    // Genuine queries produce native SDBL if the configured platform emits it.
    // Their presence and identity must be verified in captured TJ, not assumed.
    МаркерЗапроса("body_enter", Nonce, UUIDЗадания);
    ВызватьПаузу(2000);
    Если ДолжнаБытьОшибка Тогда
        МаркерЗапроса("body_raise", Nonce, UUIDЗадания);
        Сбой = Наблюдение("body_raise");
        Сбой.Вставить("batch_id", Эксперимент);
        Сбой.Вставить("job_ordinal", Порядок);
        Сбой.Вставить("nonce", Nonce);
        Сбой.Вставить("job_uuid", UUIDЗадания);
        Сбой.Вставить("job_key", Задание.Ключ);
        Сбой.Вставить("session_id", НомерСеансаИнформационнойБазы());
        Сбой.Вставить("connection_id", Сеанс.НомерСоединения);
        Сбой.Вставить("body_observed_elapsed_ms", Сбой.observed_utc_ms - Вход.observed_utc_ms);
        Сбой.Вставить("requested_pause_ms", 2000);
        Сбой.Вставить("interpretation", "immediately before intentional exception; platform Failed state must be observed by controller");
        ЗаписатьСнимок(ПутьСнимка(Каталог, "worker-raise-" + Nonce + ".json"), Сбой);
        // Deliberately uncaught in the worker: the platform must report Failed.
        ВызватьИсключение "SC01_CONTROLLED_FAILURE:" + Nonce + ":" + UUIDЗадания;
    КонецЕсли;
    МаркерЗапроса("body_exit", Nonce, UUIDЗадания);

    Выход = Наблюдение("body_exit");
    Выход.Вставить("batch_id", Эксперимент);
    Выход.Вставить("job_ordinal", Порядок);
    Выход.Вставить("nonce", Nonce);
    Выход.Вставить("job_uuid", UUIDЗадания);
    Выход.Вставить("job_key", Задание.Ключ);
    Выход.Вставить("session_id", НомерСеансаИнформационнойБазы());
    Выход.Вставить("connection_id", Сеанс.НомерСоединения);
    Выход.Вставить("body_observed_elapsed_ms", Выход.observed_utc_ms - Вход.observed_utc_ms);
    Выход.Вставить("requested_pause_ms", 2000);
    Выход.Вставить("interpretation", "callback body leaving; platform completion is observed separately by controller");
    ЗаписатьСнимок(ПутьСнимка(Каталог, "worker-exit-" + Nonce + ".json"), Выход);
КонецПроцедуры

Процедура МаркерЗапроса(Этап, Nonce, UUIDЗадания)
    Маркер = "SC01LIFECYCLE:" + Этап + ":" + Nonce + ":" + UUIDЗадания;
    Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ """ + Маркер + """ КАК SC01Run";
    Запрос.Выполнить();
КонецПроцедуры

Функция Наблюдение(Этап)
    Данные = Новый Структура;
    Данные.Вставить("schema", 1);
    Данные.Вставить("artifact_profile", "sc01-platform-background-job-v1");
    Данные.Вставить("scenario", "SC-01");
    Данные.Вставить("instrumentation_version", 4);
    Данные.Вставить("origin", "controlled_real_background_job");
    Данные.Вставить("computer_name", ИмяКомпьютера());
    Данные.Вставить("stage", Этап);
    МиллисекундыUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
    Данные.Вставить("observed_utc_ms", МиллисекундыUTC);
    Данные.Вставить("clock_epoch", "0001-01-01T00:00:00Z");
    Данные.Вставить("clock_precision", "milliseconds");
    // Derive both representations from one observation, including second rollover.
    СекундыUTC = Дата(1, 1, 1) + Цел(МиллисекундыUTC / 1000);
    Данные.Вставить("observed_utc_seconds", XMLСтрока(СекундыUTC) + "Z");
    Возврат Данные;
КонецФункции

Процедура ПроверитьКаталог(Каталог)
    Если ПустаяСтрока(Каталог) Тогда
        ВызватьИсключение "SC01: /C must contain an existing empty absolute output directory";
    КонецЕсли;
    Абсолютный = Ложь;
    Если ПолучитьРазделительПути() = "\" Тогда
        Если СтрДлина(Каталог) > 3 Тогда
            Абсолютный = Найти("ABCDEFGHIJKLMNOPQRSTUVWXYZ", ВРег(Лев(Каталог, 1))) > 0
                И Сред(Каталог, 2, 1) = ":"
                И (Сред(Каталог, 3, 1) = "\" Или Сред(Каталог, 3, 1) = "/");
        КонецЕсли;
    Иначе
        Абсолютный = СтрДлина(Каталог) > 1 И Лев(Каталог, 1) = "/";
    КонецЕсли;
    Если Не Абсолютный Тогда
        ВызватьИсключение "SC01: output directory must be an absolute local path on the 1C process host";
    КонецЕсли;
    ФайлКаталога = Новый Файл(Каталог);
    Если Не ФайлКаталога.Существует() Тогда
        ВызватьИсключение "SC01: create the dedicated output directory before running the probe";
    КонецЕсли;
    Если Не ФайлКаталога.ЭтоКаталог() Тогда
        ВызватьИсключение "SC01: output path is not a directory";
    КонецЕсли;
    Если НайтиФайлы(Каталог, "*", Ложь).Количество() <> 0 Тогда
        ВызватьИсключение "SC01: output directory must be empty for this run";
    КонецЕсли;
КонецПроцедуры

Функция ПутьСнимка(Каталог, Имя)
    Если Прав(Каталог, 1) = "/" Или Прав(Каталог, 1) = "\" Тогда
        Возврат Каталог + Имя;
    КонецЕсли;
    Возврат Каталог + ПолучитьРазделительПути() + Имя;
КонецФункции

Функция КодСостоянияЗадания(Состояние)
    Если Состояние = СостояниеФоновогоЗадания.Завершено Тогда
        Возврат "completed";
    ИначеЕсли Состояние = СостояниеФоновогоЗадания.ЗавершеноАварийно Тогда
        Возврат "failed";
    ИначеЕсли Состояние = СостояниеФоновогоЗадания.Отменено Тогда
        Возврат "canceled";
    ИначеЕсли Состояние = СостояниеФоновогоЗадания.Активно Тогда
        Возврат "active";
    КонецЕсли;
    Возврат "unknown";
КонецФункции

Процедура ЗаписатьСнимок(ИмяФайла, Данные)
    Запись = Новый ЗаписьJSON;
    Запись.ОткрытьФайл(ИмяФайла, "UTF-8", Ложь);
    ЗаписатьJSON(Запись, Данные);
    Запись.Закрыть();
КонецПроцедуры
