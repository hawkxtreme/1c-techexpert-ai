// Controlled experiment in a disposable test infobase only.
// The workload performs actual HTTP lookups and individual document writes.
// No artificial worker pauses, diagnosis text, or measured values are injected.

Процедура RunController(ПутьПараметров) Экспорт
    ПроверитьАбсолютныйПуть(ПутьПараметров);
    Настройки = ПрочитатьФайлJSON(ПутьПараметров);
    ПроверитьНастройки(Настройки);
    ПроверитьКаталог(Настройки.output_dir);
    Nonce = Строка(Новый УникальныйИдентификатор());
    ХешВхода = ХешФайла(Настройки.input_csv);
    Контроллер = Наблюдение("controller_created");
    Контроллер.Вставить("batch_id", Настройки.batch_id);
    Контроллер.Вставить("mode", Настройки.mode);
    Контроллер.Вставить("nonce", Nonce);
    Контроллер.Вставить("input_csv", Настройки.input_csv);
    Контроллер.Вставить("input_sha256", ХешВхода);
    Контроллер.Вставить("host", Настройки.host);
    Контроллер.Вставить("port", Настройки.port);
    Контроллер.Вставить("catalog_revision", Настройки.catalog_revision);
    Контроллер.Вставить("connection_string", СтрокаСоединенияИнформационнойБазы());
    Контроллер.Вставить("initiator_session_id", НомерСеансаИнформационнойБазы());
    Контроллер.Вставить("status", "submitting");
    Этапы = Новый Массив;
    Контроллер.Вставить("stages", Этапы);
    Этапы.Добавить(Наблюдение("submit_requested"));
    ЗаписатьСнимок(ПутьСнимка(Настройки.output_dir, "controller-" + Nonce + ".json"), Контроллер);
    Попытка
        Параметры = Новый Массив;
        Параметры.Добавить(Настройки);
        Параметры.Добавить(Nonce);
        Параметры.Добавить(ХешВхода);
        Задание = ФоновыеЗадания.Выполнить("SC01Lifecycle.OrderLoad", Параметры,
            Настройки.batch_id, "SC01 controlled order load");
        ИдентификаторЗадания = Задание.УникальныйИдентификатор;
        Контроллер.Вставить("job_uuid", Строка(ИдентификаторЗадания));
        Контроллер.Вставить("status", "submitted");
        Этапы.Добавить(Наблюдение("execute_returned"));
        ЗаписатьСнимок(ПутьСнимка(Настройки.output_dir, "controller-" + Nonce + ".json"), Контроллер);

        Задание = Задание.ОжидатьЗавершенияВыполнения(20);
        Задание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(ИдентификаторЗадания);
        Если Задание = Неопределено Тогда
            ВызватьИсключение "SC01: job missing after wait";
        КонецЕсли;
        Итог = Наблюдение("platform_state_refreshed");
        Итог.Вставить("job_uuid", Строка(Задание.УникальныйИдентификатор));
        Итог.Вставить("job_state", Строка(Задание.Состояние));
        Итог.Вставить("job_state_code", КодСостоянияЗадания(Задание.Состояние));
        Итог.Вставить("completed", Задание.Состояние = СостояниеФоновогоЗадания.Завершено);
        Итог.Вставить("job_method", Задание.ИмяМетода);
        Итог.Вставить("job_key", Задание.Ключ);
        Итог.Вставить("job_begin_platform_date", XMLСтрока(Задание.Начало));
        Итог.Вставить("platform_date_precision", "seconds");
        Итог.Вставить("platform_date_timezone", "not_assumed; compare with independent UTC observations");
        Если Задание.Состояние <> СостояниеФоновогоЗадания.Активно Тогда
            Итог.Вставить("job_end_platform_date", XMLСтрока(Задание.Конец));
        КонецЕсли;
        Если Задание.ИнформацияОбОшибке <> Неопределено Тогда
            Итог.Вставить("error_description", Задание.ИнформацияОбОшибке.Описание);
        КонецЕсли;
        Контроллер.Вставить("final_job_snapshot", Итог);
        Контроллер.Вставить("status", Итог.job_state_code);

        Если Итог.completed Тогда
            // Independent reread by the controller after platform job completion.
            Этапы.Добавить(Наблюдение("result_readback_started"));
            СтрокиРезультата = ПрочитатьСохраненныеЗаказы(Строка(ИдентификаторЗадания));
            Если СтрокиРезультата.Количество() <> 200 Тогда
                ВызватьИсключение "SC01: persisted result must contain 200 documents";
            КонецЕсли;
            Контроллер.Вставить("result_rows", СтрокиРезультата);
            Контроллер.Вставить("result_rows_sha256", ХешПроекции(СтрокиРезультата));
            Контроллер.Вставить("result_projection_format", "UTF-8: order_id TAB sku TAB qty TAB price TAB amount TAB catalog_revision LF; XML numeric text; sorted by order_id");
            Контроллер.Вставить("input_sha256_after", ХешФайла(Настройки.input_csv));
            Если Контроллер.input_sha256_after <> ХешВхода Тогда
                ВызватьИсключение "SC01: input file changed during the run";
            КонецЕсли;
            Этапы.Добавить(Наблюдение("result_readback_finished"));
        КонецЕсли;
        Этапы.Добавить(Наблюдение("controller_finished"));
    Исключение
        Контроллер.Вставить("status", "error");
        Контроллер.Вставить("error", ОписаниеОшибки());
        Этапы.Добавить(Наблюдение("controller_error"));
    КонецПопытки;
    ЗаписатьСнимок(ПутьСнимка(Настройки.output_dir, "controller-" + Nonce + ".json"), Контроллер);
КонецПроцедуры

Процедура OrderLoad(Настройки, Nonce, ОжидаемыйХешВхода) Экспорт
    Сеанс = ПолучитьТекущийСеансИнформационнойБазы();
    Задание = Сеанс.ПолучитьФоновоеЗадание();
    Если Задание = Неопределено Тогда
        ВызватьИсключение "SC01: not a platform background job";
    КонецЕсли;
    UUIDЗадания = Строка(Задание.УникальныйИдентификатор);
    Вход = НаблюдениеРаботника("body_enter", Настройки, Nonce, UUIDЗадания, Сеанс);
    Вход.Вставить("job_key", Задание.Ключ);
    Вход.Вставить("job_begin_platform_date", XMLСтрока(Задание.Начало));
    Вход.Вставить("platform_date_precision", "seconds");
    Вход.Вставить("platform_date_timezone", "not_assumed; compare with independent UTC observations");
    Вход.Вставить("interpretation", "callback body entered; not a platform job-start event");
    ЗаписатьСнимок(ПутьСнимка(Настройки.output_dir, "worker-enter-" + Nonce + ".json"), Вход);
    МаркерЗапроса("body_enter", Nonce, UUIDЗадания);

    Нагрузка = Новый Структура;
    Нагрузка.Вставить("mode", Настройки.mode);
    Нагрузка.Вставить("http_calls", Новый Массив);
    Нагрузка.Вставить("written_count", 0);
    Попытка
        ХешВхода = ХешФайла(Настройки.input_csv);
        Нагрузка.Вставить("input_sha256", ХешВхода);
        Если ХешВхода <> ОжидаемыйХешВхода Тогда
            ВызватьИсключение "SC01: input changed before worker read";
        КонецЕсли;
        СтрокиВхода = ПрочитатьЗаказыCSV(Настройки.input_csv);
        Если ХешФайла(Настройки.input_csv) <> ХешВхода Тогда
            ВызватьИсключение "SC01: input changed while worker read it";
        КонецЕсли;
        УникальныеSKU = Новый Соответствие;
        Для Каждого СтрокаЗаказа Из СтрокиВхода Цикл
            УникальныеSKU.Вставить(СтрокаЗаказа.sku, Истина);
        КонецЦикла;
        Если УникальныеSKU.Количество() <> 10 Тогда
            ВызватьИсключение "SC01: expected 10 distinct SKUs";
        КонецЕсли;
        Нагрузка.Вставить("input_rows", СтрокиВхода.Количество());
        Нагрузка.Вставить("unique_skus", УникальныеSKU.Количество());
        Прокси = Новый ИнтернетПрокси(Ложь);
        Соединение = Новый HTTPСоединение(Настройки.host, Настройки.port, "", "", Прокси, 5, Неопределено, Ложь);
        Кэш = Новый Соответствие; // New empty cache for this job only.
        Нагрузка.Вставить("load_started_utc_ms", ТекущаяУниверсальнаяДатаВМиллисекундах());
        Для Каждого СтрокаЗаказа Из СтрокиВхода Цикл
            ДанныеТовара = Неопределено;
            Если Настройки.mode = "cached" Тогда
                ДанныеТовара = Кэш.Получить(СтрокаЗаказа.sku);
            КонецЕсли;
            Если ДанныеТовара = Неопределено Тогда
                ДанныеТовара = ПолучитьТовар(Соединение, СтрокаЗаказа.sku, Настройки,
                    UUIDЗадания, Nonce, Нагрузка.http_calls);
                Если Настройки.mode = "cached" Тогда
                    Кэш.Вставить(СтрокаЗаказа.sku, ДанныеТовара);
                КонецЕсли;
            КонецЕсли;
            // Both modes use this same write path; each Write commits separately.
            ЗаписатьЗаказ(СтрокаЗаказа, ДанныеТовара, Настройки, UUIDЗадания);
            Нагрузка.written_count = Нагрузка.written_count + 1;
        КонецЦикла;
        Нагрузка.Вставить("load_finished_utc_ms", ТекущаяУниверсальнаяДатаВМиллисекундах());
    Исключение
        Сбой = НаблюдениеРаботника("body_error", Настройки, Nonce, UUIDЗадания, Сеанс);
        Сбой.Вставить("workload", Нагрузка);
        Сбой.Вставить("error", ОписаниеОшибки());
        ЗаписатьСнимок(ПутьСнимка(Настройки.output_dir, "worker-error-" + Nonce + ".json"), Сбой);
        ВызватьИсключение;
    КонецПопытки;

    МаркерЗапроса("body_exit", Nonce, UUIDЗадания);
    Выход = НаблюдениеРаботника("body_exit", Настройки, Nonce, UUIDЗадания, Сеанс);
    Выход.Вставить("job_key", Задание.Ключ);
    Выход.Вставить("body_observed_elapsed_ms", Выход.observed_utc_ms - Вход.observed_utc_ms);
    Выход.Вставить("workload", Нагрузка);
    Выход.Вставить("interpretation", "callback body leaving; platform completion and persisted result are observed by controller");
    ЗаписатьСнимок(ПутьСнимка(Настройки.output_dir, "worker-exit-" + Nonce + ".json"), Выход);
КонецПроцедуры

Функция ПолучитьТовар(Соединение, SKU, Настройки, UUIDЗадания, Nonce, Вызовы)
    ИдентификаторЗапроса = Строка(Новый УникальныйИдентификатор());
    Заголовки = Новый Соответствие;
    Заголовки.Вставить("X-SC01-Job", UUIDЗадания);
    Заголовки.Вставить("X-SC01-Nonce", Nonce);
    Заголовки.Вставить("X-SC01-Request", ИдентификаторЗапроса);
    Заголовки.Вставить("X-SC01-Batch", Настройки.batch_id);
    ЗапросHTTP = Новый HTTPЗапрос("/catalog/" + SKU, Заголовки);
    Вызов = Новый Структура;
    Вызов.Вставить("request_id", ИдентификаторЗапроса);
    Вызов.Вставить("job_uuid", UUIDЗадания);
    Вызов.Вставить("nonce", Nonce);
    Вызов.Вставить("sku", SKU);
    Вызов.Вставить("status", -1);
    Вызов.Вставить("started_utc_ms", ТекущаяУниверсальнаяДатаВМиллисекундах());
    Вызовы.Добавить(Вызов);
    Попытка
        Ответ = Соединение.Получить(ЗапросHTTP);
        Вызов.status = Ответ.КодСостояния;
        Тело = Ответ.ПолучитьТелоКакСтроку("UTF-8");
        Вызов.Вставить("finished_utc_ms", ТекущаяУниверсальнаяДатаВМиллисекундах());
        Если Ответ.КодСостояния <> 200 Тогда
            ВызватьИсключение "SC01: catalog HTTP status is not 200";
        КонецЕсли;
        Чтение = Новый ЧтениеJSON;
        Чтение.УстановитьСтроку(Тело);
        Товар = ПрочитатьJSON(Чтение);
        Чтение.Закрыть();
        Вызов.Вставить("response_request_id", Товар.request_id);
        Вызов.Вставить("catalog_revision", Товар.catalog_revision);
        Если Товар.request_id <> ИдентификаторЗапроса Тогда
            ВызватьИсключение "SC01: catalog response request_id does not match";
        КонецЕсли;
        Если Товар.sku <> SKU Или Товар.catalog_revision <> Настройки.catalog_revision Тогда
            ВызватьИсключение "SC01: catalog sku/revision does not match";
        КонецЕсли;
        Если ТипЗнч(Товар.price) <> Тип("Число") Тогда
            ВызватьИсключение "SC01: catalog price must be a number";
        КонецЕсли;
        Если Товар.price <= 0 Или Товар.price > 1000000 Или Товар.price <> Цел(Товар.price) Тогда
            ВызватьИсключение "SC01: catalog price must be a bounded positive integer";
        КонецЕсли;
    Исключение
        Вызов.Вставить("finished_utc_ms", ТекущаяУниверсальнаяДатаВМиллисекундах());
        Вызов.Вставить("error", ОписаниеОшибки());
        ВызватьИсключение;
    КонецПопытки;
    Возврат Товар;
КонецФункции

Процедура ЗаписатьЗаказ(СтрокаЗаказа, Товар, Настройки, UUIDЗадания)
    Заказ = Документы.SC01Order.СоздатьДокумент();
    Заказ.Дата = Дата(2026, 1, 1, 12, 0, 0);
    Заказ.BatchID = Настройки.batch_id;
    Заказ.JobUUID = UUIDЗадания;
    Заказ.Mode = Настройки.mode;
    Заказ.SourceOrderID = СтрокаЗаказа.order_id;
    Заказ.ItemCode = СтрокаЗаказа.sku;
    Заказ.Quantity = СтрокаЗаказа.qty;
    Заказ.Price = Товар.price;
    Заказ.Amount = СтрокаЗаказа.qty * Товар.price;
    Заказ.CatalogRevision = Товар.catalog_revision;
    Заказ.Записать(РежимЗаписиДокумента.Запись);
КонецПроцедуры

Функция ПрочитатьСохраненныеЗаказы(UUIDЗадания)
    Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ
    | Заказы.SourceOrderID КАК order_id,
    | Заказы.ItemCode КАК sku,
    | Заказы.Quantity КАК qty,
    | Заказы.Price КАК price,
    | Заказы.Amount КАК amount,
    | Заказы.CatalogRevision КАК catalog_revision
    |ИЗ Документ.SC01Order КАК Заказы
    |ГДЕ Заказы.JobUUID = &JobUUID
    |УПОРЯДОЧИТЬ ПО Заказы.SourceOrderID";
    Запрос.УстановитьПараметр("JobUUID", UUIDЗадания);
    Выборка = Запрос.Выполнить().Выбрать();
    Строки = Новый Массив;
    Пока Выборка.Следующий() Цикл
        Если Строки.Количество() >= 200 Тогда
            ВызватьИсключение "SC01: more than 200 persisted result rows";
        КонецЕсли;
        Строка = Новый Структура;
        Строка.Вставить("order_id", Выборка.order_id);
        Строка.Вставить("sku", Выборка.sku);
        Строка.Вставить("qty", Выборка.qty);
        Строка.Вставить("price", Выборка.price);
        Строка.Вставить("amount", Выборка.amount);
        Строка.Вставить("catalog_revision", Выборка.catalog_revision);
        Строки.Добавить(Строка);
    КонецЦикла;
    Возврат Строки;
КонецФункции

Функция ПрочитатьЗаказыCSV(Путь)
    Текст = Новый ТекстовыйДокумент;
    Текст.Прочитать(Путь, "UTF-8");
    Если СокрЛП(Текст.ПолучитьСтроку(1)) <> "order_id,sku,qty" Тогда
        ВызватьИсключение "SC01: CSV header must be order_id,sku,qty";
    КонецЕсли;
    Строки = Новый Массив;
    Идентификаторы = Новый Соответствие;
    Для Номер = 2 По Текст.КоличествоСтрок() Цикл
        СтрокаCSV = СокрЛП(Текст.ПолучитьСтроку(Номер));
        Если ПустаяСтрока(СтрокаCSV) Тогда
            Продолжить;
        КонецЕсли;
        Поля = СтрРазделить(СтрокаCSV, ",", Истина);
        Если Поля.Количество() <> 3 Тогда
            ВызватьИсключение "SC01: controlled CSV requires exactly three unquoted columns";
        КонецЕсли;
        ПроверитьТокен(Поля[0], 40);
        ПроверитьТокен(Поля[1], 6);
        Если СтрДлина(Поля[1]) <> 6 Или Лев(Поля[1], 5) <> "SKU00" Тогда
            ВызватьИсключение "SC01: SKU must be SKU000 through SKU009";
        КонецЕсли;
        Если Найти("0123456789", Прав(Поля[1], 1)) = 0 Тогда
            ВызватьИсключение "SC01: invalid SKU suffix";
        КонецЕсли;
        Если Идентификаторы.Получить(Поля[0]) <> Неопределено Тогда
            ВызватьИсключение "SC01: duplicate source order_id";
        КонецЕсли;
        Идентификаторы.Вставить(Поля[0], Истина);
        Количество = Число(Поля[2]);
        Если Количество <= 0 Или Количество > 1000 Или Количество <> Цел(Количество) Тогда
            ВызватьИсключение "SC01: qty must be a bounded positive integer";
        КонецЕсли;
        Строки.Добавить(Новый Структура("order_id,sku,qty", Поля[0], Поля[1], Количество));
        Если Строки.Количество() > 200 Тогда
            ВызватьИсключение "SC01: more than 200 input rows";
        КонецЕсли;
    КонецЦикла;
    Если Строки.Количество() <> 200 Тогда
        ВызватьИсключение "SC01: expected exactly 200 input rows";
    КонецЕсли;
    Возврат Строки;
КонецФункции

Функция ХешФайла(Путь)
    Хеш = Новый ХешированиеДанных(ХешФункция.SHA256);
    Хеш.ДобавитьФайл(Путь);
    Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеш.ХешСумма));
КонецФункции

Функция ХешПроекции(Строки)
    Хеш = Новый ХешированиеДанных(ХешФункция.SHA256);
    Для Каждого Строка Из Строки Цикл
        Канон = Строка.order_id + Символы.Таб + Строка.sku + Символы.Таб
            + XMLСтрока(Строка.qty) + Символы.Таб + XMLСтрока(Строка.price) + Символы.Таб
            + XMLСтрока(Строка.amount) + Символы.Таб + Строка.catalog_revision + Символы.ПС;
        Хеш.Добавить(Канон); // Text is hashed as UTF-8, per platform API.
    КонецЦикла;
    Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеш.ХешСумма));
КонецФункции

Функция ПрочитатьФайлJSON(Путь)
    Чтение = Новый ЧтениеJSON;
    Чтение.ОткрытьФайл(Путь, "UTF-8");
    Данные = ПрочитатьJSON(Чтение);
    Чтение.Закрыть();
    Возврат Данные;
КонецФункции

Процедура ПроверитьНастройки(Настройки)
    Если Настройки.host <> "127.0.0.1" Тогда
        ВызватьИсключение "SC01: only explicit IPv4 loopback is allowed";
    КонецЕсли;
    Если Настройки.port < 1024 Или Настройки.port > 65535 Или Настройки.port <> Цел(Настройки.port) Тогда
        ВызватьИсключение "SC01: port must be an integer in 1024..65535";
    КонецЕсли;
    Если Настройки.mode <> "baseline" И Настройки.mode <> "cached" Тогда
        ВызватьИсключение "SC01: mode must be baseline or cached";
    КонецЕсли;
    Если Настройки.catalog_revision <> "sc01-catalog-v1" Тогда
        ВызватьИсключение "SC01: unexpected catalog revision";
    КонецЕсли;
    ПроверитьТокен(Настройки.batch_id, 36);
    ПроверитьАбсолютныйПуть(Настройки.input_csv);
    ПроверитьАбсолютныйПуть(Настройки.output_dir);
КонецПроцедуры

Процедура ПроверитьТокен(Значение, Максимум)
    Если ПустаяСтрока(Значение) Или СтрДлина(Значение) > Максимум Тогда
        ВызватьИсключение "SC01: invalid bounded identifier";
    КонецЕсли;
    Для Индекс = 1 По СтрДлина(Значение) Цикл
        Если Найти("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_-", Сред(Значение, Индекс, 1)) = 0 Тогда
            ВызватьИсключение "SC01: identifier contains unsupported characters";
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Процедура ПроверитьАбсолютныйПуть(Путь)
    Если ПустаяСтрока(Путь) Тогда
        ВызватьИсключение "SC01: explicit absolute local path required";
    КонецЕсли;
    Абсолютный = Ложь;
    Если ПолучитьРазделительПути() = "\" Тогда
        Если СтрДлина(Путь) > 3 Тогда
            Абсолютный = Найти("ABCDEFGHIJKLMNOPQRSTUVWXYZ", ВРег(Лев(Путь, 1))) > 0
                И Сред(Путь, 2, 1) = ":"
                И (Сред(Путь, 3, 1) = "\" Или Сред(Путь, 3, 1) = "/");
        КонецЕсли;
    Иначе
        Абсолютный = СтрДлина(Путь) > 1 И Лев(Путь, 1) = "/";
    КонецЕсли;
    Если Не Абсолютный Тогда
        ВызватьИсключение "SC01: explicit absolute local path required";
    КонецЕсли;
КонецПроцедуры

Процедура ПроверитьКаталог(Каталог)
    ПроверитьАбсолютныйПуть(Каталог);
    ФайлКаталога = Новый Файл(Каталог);
    Если Не ФайлКаталога.Существует() Тогда
        ВызватьИсключение "SC01: create the output directory first";
    КонецЕсли;
    Если Не ФайлКаталога.ЭтоКаталог() Тогда
        ВызватьИсключение "SC01: output path is not a directory";
    КонецЕсли;
    Если НайтиФайлы(Каталог, "*", Ложь).Количество() <> 0 Тогда
        ВызватьИсключение "SC01: output directory must be empty";
    КонецЕсли;
КонецПроцедуры

Функция НаблюдениеРаботника(Этап, Настройки, Nonce, UUIDЗадания, Сеанс)
    Данные = Наблюдение(Этап);
    Данные.Вставить("batch_id", Настройки.batch_id);
    Данные.Вставить("mode", Настройки.mode);
    Данные.Вставить("nonce", Nonce);
    Данные.Вставить("job_uuid", UUIDЗадания);
    Данные.Вставить("session_id", НомерСеансаИнформационнойБазы());
    Данные.Вставить("session_info_number", Сеанс.НомерСеанса);
    Данные.Вставить("connection_id", Сеанс.НомерСоединения);
    Данные.Вставить("connection_string", СтрокаСоединенияИнформационнойБазы());
    Возврат Данные;
КонецФункции

Функция Наблюдение(Этап)
    Данные = Новый Структура;
    Данные.Вставить("schema", 1);
    Данные.Вставить("artifact_profile", "sc01-platform-background-job-v1");
    Данные.Вставить("scenario", "SC-01");
    Данные.Вставить("instrumentation_version", 4);
    Данные.Вставить("origin", "controlled_real_background_job");
    Данные.Вставить("workload_profile", "sc01-order-load-v1");
    Данные.Вставить("computer_name", ИмяКомпьютера());
    Данные.Вставить("stage", Этап);
    МиллисекундыUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
    Данные.Вставить("observed_utc_ms", МиллисекундыUTC);
    Данные.Вставить("clock_epoch", "0001-01-01T00:00:00Z");
    Данные.Вставить("clock_precision", "milliseconds");
    // Derive both representations from the same observation across second rollover.
    СекундыUTC = Дата(1, 1, 1) + Цел(МиллисекундыUTC / 1000);
    Данные.Вставить("observed_utc_seconds", XMLСтрока(СекундыUTC) + "Z");
    Возврат Данные;
КонецФункции

Функция КодСостоянияЗадания(Состояние)
    Если Состояние = СостояниеФоновогоЗадания.Завершено Тогда
        Возврат "completed";
    ИначеЕсли Состояние = СостояниеФоновогоЗадания.ЗавершеноАварийно Тогда
        Возврат "failed";
    ИначеЕсли Состояние = СостояниеФоновогоЗадания.Отменено Тогда
        Возврат "canceled";
    ИначеЕсли Состояние = СостояниеФоновогоЗадания.Активно Тогда
        Возврат "active";
    КонецЕсли;
    Возврат "unknown";
КонецФункции

Функция ПутьСнимка(Каталог, Имя)
    Если Прав(Каталог, 1) = "/" Или Прав(Каталог, 1) = "\" Тогда
        Возврат Каталог + Имя;
    КонецЕсли;
    Возврат Каталог + ПолучитьРазделительПути() + Имя;
КонецФункции

Процедура МаркерЗапроса(Этап, Nonce, UUIDЗадания)
    Маркер = "SC01LIFECYCLE:" + Этап + ":" + Nonce + ":" + UUIDЗадания;
    Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ """ + Маркер + """ КАК SC01Run";
    Запрос.Выполнить();
КонецПроцедуры

Процедура ЗаписатьСнимок(ИмяФайла, Данные)
    Запись = Новый ЗаписьJSON;
    Запись.ОткрытьФайл(ИмяФайла, "UTF-8", Ложь);
    ЗаписатьJSON(Запись, Данные);
    Запись.Закрыть();
КонецПроцедуры
